# Copy to deploy/.env (mode 600).
PHEROMILL_IMAGE=
PHEROMILL_REPOSITORY=owner/name
PHEROMILL_HOME=/var/lib/pheromill
DOCKER_GID=
# Only for a private repository: a token that can read this repository and
# nothing else. The runner and egress services use it to fetch the trunk.
# Leave empty for a public repository.
PHEROMILL_READ_TOKEN=
