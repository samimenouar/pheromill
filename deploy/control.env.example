# Copy to deploy/control.env (mode 600). Forge credentials: control zone only.
# Preferred: a GitHub App, which yields one-hour tokens limited to this repository.
# The private key itself is long-lived: store it as
# <PHEROMILL_HOME>/control/app-private-key.pem, mode 600, owner 10001.
# App permissions needed: Contents, Pull requests and Issues (read and write),
# and Checks (read).
PHEROMILL_GITHUB_APP_ID=
PHEROMILL_GITHUB_INSTALLATION_ID=
PHEROMILL_GITHUB_PRIVATE_KEY_FILE=/state/app-private-key.pem
# Only if the factory may publish changes to files under .github/workflows/
# (CRITICAL changes): grant the App the Workflows permission (write), then:
# PHEROMILL_GITHUB_WORKFLOWS=write
# Alternative for a first trial: a fine-grained token limited to this repository.
# PHEROMILL_FORGE_TOKEN=
